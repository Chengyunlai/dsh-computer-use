{
  "name": "@local/dsh-computer-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Computer Use tools for DeepSeek Harness: let the model observe and operate a live browser through screenshot, click, type, keypress, scroll, and state snapshots.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "drivers/*.js",
    "lib/*.js",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "playwright-core": "^1.49.0"
  }
}
